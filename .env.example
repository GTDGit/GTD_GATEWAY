# ============================================
# GTD Gateway (Go Admin Backend) — Environment Configuration
# ============================================
# This file enumerates every environment variable the Gateway reads.
# Replace every placeholder with a real value in your local .env (which is
# git-ignored). NO REAL SECRETS belong in this example file.
#
# The Gateway serves only the admin surface (/v1/admin/* + /v1/health) on
# port 8081. It runs NO background workers and NO database migrations.

# ============================================
# APPLICATION
# ============================================
PORT=8081
ENV=development
BASE_URL=https://dev-gateway.gtd.co.id

# ============================================
# DATABASE (AWS RDS over verified TLS)
# ============================================
# DB_HOST = RDS endpoint, DB_PORT = 5432, DB_USER = RDS master user.
DB_HOST=dev-postgres.ctwq6wii0ika.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_rds_password_here
DB_NAME=gtd
# DB_SSLMODE=verify-full requires an encrypted, fully verified TLS connection:
# it validates the RDS server certificate against the CA bundle referenced by
# DB_SSLROOTCERT. The Gateway runs no migrations — only the API alters schema.
DB_SSLMODE=verify-full
# Path to the AWS RDS CA bundle, mounted read-only into the container at
# /app/certs (docker-compose mounts host ./certs as ./certs:/app/certs:ro).
DB_SSLROOTCERT=/app/certs/rds-global-bundle.pem

# ============================================
# REDIS (shared instance — admin SSE bridge)
# ============================================
# IMPORTANT: REDIS_HOST must point at the SHARED Redis instance the API
# publishes domain events to. The Gateway SUBSCRIBEs to events:* on this same
# instance and fans them out to admin SSE clients (GET /v1/admin/sse). Do NOT
# point this at an isolated per-stack Redis, or admin real-time updates break.
REDIS_HOST=your_shared_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ============================================
# QRIS DOCUMENT PORTAL (files.qris.gtd.co.id)
# ============================================
# The gateway uploads merchant onboarding documents (KTP, selfie+KTP,
# business-location photo, extra) to a PRIVATE S3 bucket and returns a
# token-gated shareable link on this base URL. Files are never public.
#
# FILES_BASE_URL = public origin of the portal, no trailing slash.
FILES_BASE_URL=https://dev-files.qris.gtd.co.id
# Dedicated S3 bucket for QRIS documents ONLY, in the Jakarta region
# (ap-southeast-3) for Indonesian data residency. The bucket MUST block all
# public access. Env is prefixed FILES_S3_* to keep it separate from any other
# storage config.
FILES_S3_REGION=ap-southeast-3
FILES_S3_BUCKET=gtd-qris-docs-dev
# Leave empty for real AWS; set for MinIO (path-style) in local dev.
FILES_S3_ENDPOINT=
# Prefer an IAM role over static keys in production. If using keys, scope to
# s3:PutObject/s3:GetObject/s3:DeleteObject on this bucket only.
FILES_S3_ACCESS_KEY=
FILES_S3_SECRET_KEY=
# Object key prefix inside the bucket.
FILES_S3_KEY_PREFIX=qris-docs

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your_jwt_secret_here

# ============================================
# PROVIDER CREDENTIALS
# ============================================
# Required by the retained provider clients that admin retry/refund reach.
# The Gateway exposes no client/webhook routes; these clients exist only so
# admin-triggered PPOB retry and payment refund can re-execute against
# providers. Private-key files are mounted read-only at /app/keys.

# --- PPOB - Digiflazz ---
DIGIFLAZZ_USERNAME=your_username
DIGIFLAZZ_KEY_PRODUCTION=your_production_api_key
DIGIFLAZZ_KEY_DEVELOPMENT=your_development_api_key
DIGIFLAZZ_WEBHOOK_SECRET=your_webhook_secret

# --- PPOB - Kiosbank ---
KIOSBANK_BASE_URL=https://kiosbank-api-url
KIOSBANK_MERCHANT_ID=your_merchant_id
KIOSBANK_COUNTER_ID=your_counter_id
KIOSBANK_ACCOUNT_ID=your_account_id
KIOSBANK_MITRA=your_mitra
KIOSBANK_USERNAME=your_username
KIOSBANK_PASSWORD=your_password

# --- PPOB - Alterra ---
ALTERRA_BASE_URL=https://horven-api.sumpahpalapa.com/api
ALTERRA_CLIENT_ID=your_alterra_client_id
ALTERRA_PRIVATE_KEY_PATH=keys/alterra/private_key.pem
ALTERRA_PRIVATE_KEY_PEM=
ALTERRA_CALLBACK_PUBLIC_KEY=

# --- Payment - Pakailink ---
PAKAILINK_ENV=SANDBOX
PAKAILINK_BASE_URL=https://apigw-sandbox.pakailink.co.id
PAKAILINK_CLIENT_ID=your_pakailink_client_id
PAKAILINK_CLIENT_SECRET=your_pakailink_client_secret
PAKAILINK_PARTNER_ID=SANDBOX
PAKAILINK_PRIVATE_KEY_PATH=keys/pakailink/private_key.pem
PAKAILINK_CALLBACK_URL=https://dev-gateway.gtd.co.id/v1/webhook/pakailink

# --- Payment & Disbursement - BRI Direct ---
BRI_ENV=SANDBOX
BRI_BASE_URL=https://sandbox.partner.api.bri.co.id
BRI_CLIENT_ID=your_bri_client_id
BRI_CLIENT_SECRET=your_bri_client_secret
BRI_PARTNER_ID=your_bri_partner_id
BRI_CHANNEL_ID=your_bri_channel_id
BRI_BRIVA_NUMBER=your_briva_number
BRI_COMPANY_CODE=your_company_code
BRI_SOURCE_ACCOUNT=your_source_account
BRI_PRIVATE_KEY_PATH=keys/bri/private_key.pem
BRI_VA_CALLBACK_URL=
BRI_DISB_CALLBACK_URL=
BRI_CONNECTOR_CLIENT_KEY=
BRI_CONNECTOR_PUBLIC_KEY_PATH=
BRI_CONNECTOR_PUBLIC_KEY_PEM=
BRI_BRIZZI_USERNAME=your_brizzi_username
BRI_BRIZZI_DENOMINATIONS=20000,50000,100000,150000,200000

# --- Payment & Disbursement - BNC Direct / Bank Neo ---
BNC_ENV=SANDBOX
BNC_CLIENT_ID=your_bnc_client_id
BNC_CLIENT_SECRET=your_bnc_client_secret
BNC_PARTNER_ID=your_bnc_partner_id
BNC_CHANNEL_ID=your_channel_id
BNC_SOURCE_ACCOUNT=your_source_account
BNC_PRIVATE_KEY_PATH=keys/bnc/private_key.pem
BNC_CONNECTOR_CLIENT_KEY=
BNC_CONNECTOR_PUBLIC_KEY_PATH=
BNC_CONNECTOR_PUBLIC_KEY_PEM=
BNC_VA_CALLBACK_URL=
BNC_DISB_CALLBACK_URL=

# --- Payment - DANA Direct ---
DANA_ENV=SANDBOX
DANA_BASE_URL=https://api.sandbox.dana.id
DANA_MERCHANT_ID=your_dana_merchant_id
DANA_CLIENT_ID=your_dana_client_id
DANA_CLIENT_SECRET=your_dana_client_secret
DANA_PARTNER_ID=SANDBOX
DANA_PRIVATE_KEY_PATH=keys/dana/private_key.pem
DANA_CALLBACK_URL=https://dev-gateway.gtd.co.id/v1/webhook/dana

# --- Payment - Midtrans ---
MIDTRANS_ENV=SANDBOX
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_CALLBACK_URL=https://dev-gateway.gtd.co.id/v1/webhook/midtrans

# --- Payment - Xendit ---
XENDIT_ENV=SANDBOX
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_API_KEY=xnd_development_xxxxx
XENDIT_WEBHOOK_TOKEN=your_xendit_callback_token
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token
XENDIT_CALLBACK_URL=https://dev-gateway.gtd.co.id/v1/webhook/xendit
